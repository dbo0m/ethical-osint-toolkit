from pathlib import Path

from PIL import Image
from PIL.ExifTags import TAGS
from pypdf import PdfReader


def extract_image_metadata(file_path: str):
    path = Path(file_path)
    if not path.exists():
        return {"file": str(path), "error": "File not found."}

    try:
        with Image.open(path) as img:
            exif_data = img.getexif()
            extracted = {
                TAGS.get(tag, tag): value
                for tag, value in exif_data.items()
            }
        return {
            "file": str(path),
            "type": "image",
            "metadata": extracted
        }
    except Exception as exc:
        return {
            "file": str(path),
            "type": "image",
            "error": str(exc)
        }


def extract_pdf_metadata(file_path: str):
    path = Path(file_path)
    if not path.exists():
        return {"file": str(path), "error": "File not found."}

    try:
        reader = PdfReader(str(path))
        metadata = reader.metadata
        result = {}
        if metadata is not None:
            for key, value in metadata.items():
                result[str(key)] = str(value)
        return {
            "file": str(path),
            "type": "pdf",
            "metadata": result
        }
    except Exception as exc:
        return {
            "file": str(path),
            "type": "pdf",
            "error": str(exc)
        }


def extract_file_metadata(file_path: str):
    path = Path(file_path)
    if not path.exists():
        return {"file": str(path), "error": "File not found."}

    suffix = path.suffix.lower()

    if suffix in {".jpg", ".jpeg", ".png", ".bmp", ".gif", ".tiff", ".webp"}:
        return extract_image_metadata(str(path))

    if suffix == ".pdf":
        return extract_pdf_metadata(str(path))

    return {
        "file": str(path),
        "type": "unsupported",
        "message": "This file type is not supported by the current metadata extractor."
    }
